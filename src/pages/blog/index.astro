---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/blog';

const posts = await getPosts();
---

<Base title="Blog | Kivo" description="News and release notes from the Kivo project.">
	<main class="wrap page">
		<div class="head">
			<h1>Blog</h1>
			<a class="rss" href="/blog/rss.xml">RSS feed</a>
		</div>
		{
			posts.length === 0 ? (
				<p class="empty">No posts yet.</p>
			) : (
				<ul class="posts">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
								<h2>
									{post.data.title}
									{post.data.draft && <span class="draft">Draft</span>}
								</h2>
								<p>{post.data.description}</p>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</main>
</Base>

<style>
	.page {
		max-width: 760px;
		padding-top: 72px;
		padding-bottom: 128px;
	}
	.head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
	}
	h1 {
		margin: 0;
		font-size: 44px;
		line-height: 1.1;
		font-weight: 700;
		letter-spacing: -0.025em;
	}
	.rss {
		font-size: 14px;
		color: var(--accent);
	}
	.empty {
		margin-top: 40px;
		color: var(--muted);
		font-size: 17px;
	}
	.posts {
		list-style: none;
		margin: 40px 0 0;
		padding: 0;
		display: grid;
		gap: 12px;
	}
	.posts a {
		display: block;
		padding: 24px;
		border-radius: 16px;
		background: var(--card);
	}
	.posts a:hover {
		background: var(--raised);
		color: var(--text);
	}
	time {
		font-size: 13px;
		color: var(--muted);
	}
	h2 {
		margin: 6px 0 0;
		font-size: 22px;
		line-height: 1.3;
		font-weight: 600;
	}
	.posts p {
		margin: 8px 0 0;
		color: var(--text-body);
		line-height: 1.6;
	}
	.draft {
		margin-left: 10px;
		padding: 2px 8px;
		border-radius: 6px;
		background: var(--hover);
		font-size: 12px;
		font-weight: 600;
		color: var(--muted);
		vertical-align: middle;
	}
</style>
